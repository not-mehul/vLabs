{
  "name": "vlabs",
  "version": "1.1.0",
  "description": "Dynamic lab manual — repo-level dev tooling (lint/format/test) for the server and client workspaces",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{server,client}/src/**/*.{js,jsx,css}\" \"{server,client}/tests/**/*.js\" \"shared/**/*.js\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"{server,client}/src/**/*.{js,jsx,css}\" \"{server,client}/tests/**/*.js\" \"shared/**/*.js\"",
    "test": "npm test --prefix server && npm test --prefix client",
    "test:server": "npm test --prefix server",
    "test:client": "npm test --prefix client"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
