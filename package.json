{
  "name": "vlabs",
  "version": "1.0.0",
  "description": "Dynamic lab manual — repo-level dev tooling (lint/format) for the server and client workspaces",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{server,client}/src/**/*.{js,jsx,css}\" \"server/tests/**/*.js\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"{server,client}/src/**/*.{js,jsx,css}\" \"server/tests/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
