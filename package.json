{
  "name": "vlabs",
  "version": "1.3.0",
  "description": "Dynamic lab manual — repo-level dev tooling (setup/dev/build/lint/format/test) for the server and client workspaces",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && npm ci --prefix server && npm ci --prefix client",
    "dev": "node scripts/dev.js",
    "build": "npm run build --prefix client",
    "start": "node server/src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{server,client}/src/**/*.{js,jsx,css}\" \"{server,client}/tests/**/*.js\" \"shared/**/*.js\" \"scripts/**/*.js\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"{server,client}/src/**/*.{js,jsx,css}\" \"{server,client}/tests/**/*.js\" \"shared/**/*.js\" \"scripts/**/*.js\"",
    "test": "npm test --prefix server && npm test --prefix client",
    "test:server": "npm test --prefix server",
    "test:client": "npm test --prefix client"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
