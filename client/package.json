{
  "name": "vlabs-client",
  "version": "1.18.1",
  "description": "SPA frontend for the vLabs dynamic lab manual",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node studio/build.mjs && vite",
    "build": "node studio/build.mjs && vite build",
    "build:studio": "node studio/build.mjs",
    "check:studio": "node studio/build.mjs --check",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.js\""
