    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.7"
  }
