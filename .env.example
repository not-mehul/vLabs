# -------------------------------------------------------------------------
# vLabs environment configuration. Copy to `.env` and adjust.
# Every value has a safe development default, so the app also boots with none
# of these set. Set the secrets before any real deployment.
# -------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# SQLite database file location (absolute recommended in production/containers)
# DB_PATH=/app/server/data/vlabs.sqlite

# JWT signing secrets — MUST be long random strings in production.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_INSTRUCTOR_SECRET=dev-instructor-secret-change-me
JWT_PARTICIPANT_SECRET=dev-participant-secret-change-me

# Token lifetimes (participant access is additionally gated by the live session)
JWT_INSTRUCTOR_TTL=12h
JWT_PARTICIPANT_TTL=12h

# Bootstrap instructor created on first run (only if no instructor exists yet)
SEED_INSTRUCTOR_USERNAME=instructor
SEED_INSTRUCTOR_PASSWORD=labmanual123

# Allowed CORS origins (comma-separated). Leave empty in production when the
# backend serves the SPA from the same origin. Use the Vite dev server in dev.
CORS_ORIGINS=http://localhost:5173
