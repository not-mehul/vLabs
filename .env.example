# vLabs configuration. Copy to `.env` at the repo root; never commit the real file.
#
#   Mac (dev)   : `cp .env.example .env` is optional — the defaults below boot
#                 as-is with `npm run dev`. Only JWT/seed overrides matter.
#   Pi (prod)   : not used. deploy/pi/install.sh generates the equivalent at
#                 /etc/vlabs/vlabs.env (with real secrets) and systemd loads it;
#                 the same variable names apply.
#
# Read by server/src/config.js (always from the repo root, whatever the cwd).
# Real environment variables take precedence over this file.

# ---- Mode --------------------------------------------------------------
# development: Vite dev server on :5173 serves the SPA and proxies /api here;
#              weak dev secrets are tolerated (with a warning).
# production : the backend serves client/dist itself; weak/placeholder
#              secrets, identical secrets or a default seed password are FATAL.
NODE_ENV=development

# ---- Server ------------------------------------------------------------
PORT=4000
# Bind address. 127.0.0.1 (default) = only Vite / Caddy on the same machine
# can reach Node. Use 0.0.0.0 only to expose Node itself (e.g. phone testing).
HOST=127.0.0.1
# DB_PATH=./server/data/vlabs.sqlite      # Pi: /var/lib/vlabs/vlabs.sqlite

# ---- Secrets (REQUIRED in production; the server refuses weak/placeholder
#      values of fewer than 32 characters). Generate with: openssl rand -hex 32
JWT_INSTRUCTOR_SECRET=
JWT_PARTICIPANT_SECRET=
# JWT_INSTRUCTOR_TTL=12h
# JWT_PARTICIPANT_TTL=12h

# ---- Bootstrap instructor (used only when no instructor exists yet). In
#      production the server refuses to CREATE this account with the default
#      password. Change it afterwards from the portal (Account page).
SEED_INSTRUCTOR_USERNAME=instructor
SEED_INSTRUCTOR_PASSWORD=
# MIN_PASSWORD_LENGTH=10

# ---- Networking --------------------------------------------------------
# Express `trust proxy`: how many reverse-proxy hops to trust for client IPs.
#   empty/false = exposed directly (dev default) · 1 = behind Caddy on the Pi ·
#   true = trust all (only on a private network) · or a CIDR/keyword list.
# Setting this wrongly lets clients spoof their IP and dodge per-IP limits.
TRUST_PROXY=
# Only when the app is reached over plain http:// with NO TLS in front:
# disables HSTS + CSP upgrade-insecure-requests. The Pi path uses Caddy with
# HTTPS, so this stays false there. Never true on the public internet.
SERVE_PLAIN_HTTP=false
# Allowed browser origins in development (the Vite dev server). Leave empty in
# production, where the backend serves the SPA from the same origin.
CORS_ORIGINS=http://localhost:5173

# ---- Operations --------------------------------------------------------
# LOG_LEVEL=info            # debug | info | warn | error | silent
# LOG_FORMAT=pretty         # pretty (dev default) | json (production default)
# EXPIRED_SESSION_GRACE_MINUTES=60   # expired sessions auto-end after this

# ---- Client (Vite dev server only) ------------------------------------
# VITE_API_TARGET=http://127.0.0.1:4000
