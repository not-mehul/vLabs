# vLabs backend — bare-metal Raspberry Pi (installed by deploy/pi/install.sh).
#
# Node listens on 127.0.0.1:4000 only; Caddy (deploy/pi/Caddyfile) terminates
# HTTPS on :443 and proxies to it. Configuration comes from
# /etc/vlabs/vlabs.env (root:vlabs 0640). Code lives read-only in /opt/vlabs,
# state (SQLite + backups) in /var/lib/vlabs.
#
#   sudo systemctl status vlabs        sudo journalctl -u vlabs -f
#   sudo systemctl restart vlabs       sudo /opt/vlabs/deploy/pi/update.sh
[Unit]
Description=vLabs dynamic lab manual (API + SPA)
Documentation=https://github.com/not-mehul/vLabs
After=network-online.target time-sync.target
Wants=network-online.target
# Pull Caddy up alongside so https:// works after a reboot even if someone
# disabled it by hand; failure of one does not take the other down.
Wants=caddy.service

[Service]
Type=simple
User=vlabs
Group=vlabs
WorkingDirectory=/opt/vlabs
EnvironmentFile=/etc/vlabs/vlabs.env
# Belt and braces: never run the production guard rails in dev mode by mistake.
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/vlabs/server/src/index.js
Restart=always
RestartSec=3
# index.js closes idle sockets and checkpoints SQLite on SIGTERM (8 s budget).
KillSignal=SIGTERM
TimeoutStopSec=15

# Creates /var/lib/vlabs owned by vlabs:vlabs and makes it writable below.
StateDirectory=vlabs
StateDirectoryMode=0750

# Hardening (everything else on the filesystem is read-only to the service).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
# Node has no need to bind :80/:443 — Caddy does that.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
