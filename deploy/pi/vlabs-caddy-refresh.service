# Keep vLabs reachable on whatever network the Pi is plugged into.
#
# Renders the Caddy site list at boot and again every time the Pi's IPv4
# addresses change (new network, Wi-Fi switch, new DHCP lease, cable pulled),
# so the certificate always covers the current addresses and the portal shows
# the current join addresses. Names given to install.sh are kept
# (/etc/vlabs/caddy-sites.conf); Caddy is reloaded only when something changed.
#   sudo systemctl status vlabs-caddy-refresh
#   sudo journalctl -u vlabs-caddy-refresh -f
[Unit]
Description=Keep vLabs' Caddy sites in step with the Pi's network addresses
Wants=network-online.target
After=network-online.target caddy.service avahi-daemon.service

[Service]
Type=simple
ExecStart=/opt/vlabs/deploy/pi/watch-network.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
