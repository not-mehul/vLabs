# Real Let's Encrypt certificate obtained through a DNS-01 challenge — works
# even when the host is NOT reachable from the internet (e.g. the Pi on the
# LAN with lab.partner.example pointing at a private IP). Requires the Caddy
# image built with the DNS plugin (docker-compose.dns01.yml) and an API token
# scoped to edit DNS for that zone.
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
	encode zstd gzip
	reverse_proxy vlabs:4000
}
