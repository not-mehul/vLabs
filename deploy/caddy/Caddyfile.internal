# HTTPS on the LAN using Caddy's built-in CA. Devices must trust the root
# certificate once (export it with:
#   docker compose -f docker-compose.prod.yml cp caddy:/data/caddy/pki/authorities/local/root.crt ./vlabs-root.crt
# and install it via MDM or manually). HTTP on :80 redirects to HTTPS.
# SITE_ADDRESS may list several names: "vlabs.local, 192.168.1.50".
{$SITE_ADDRESS} {
	tls internal
	encode zstd gzip
	reverse_proxy vlabs:4000
}
