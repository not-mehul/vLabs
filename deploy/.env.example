# deploy/.env — read by docker compose for deploy/docker-compose.prod.yml.
# Copy to deploy/.env and fill in. Never commit the real file.

# ---- Image -------------------------------------------------------------
# Published by .github/workflows/release.yml (multi-arch: amd64 + arm64).
# Leave as-is to build locally with `--build` instead of pulling.
VLABS_IMAGE=ghcr.io/OWNER/vlabs:latest

# ---- Secrets (required) ------------------------------------------------
JWT_INSTRUCTOR_SECRET=
JWT_PARTICIPANT_SECRET=
# First start only (creates the bootstrap instructor). Change it in the portal afterwards.
SEED_INSTRUCTOR_USERNAME=instructor
SEED_INSTRUCTOR_PASSWORD=

# ---- TLS mode ----------------------------------------------------------
# Pick ONE Caddyfile (see docker-compose.prod.yml header):
CADDYFILE=./caddy/Caddyfile.http
# Must be true with Caddyfile.http, false with every other Caddyfile.
SERVE_PLAIN_HTTP=true
# Hostname(s) for the TLS modes. Examples:
#   LAN internal CA : vlabs.local, 192.168.1.50
#   Public / DNS-01 : labs.partner.example
SITE_ADDRESS=vlabs.local
ACME_EMAIL=
# Only for Caddyfile.dns01:
CLOUDFLARE_API_TOKEN=

# ---- Operations --------------------------------------------------------
LOG_LEVEL=info
EXPIRED_SESSION_GRACE_MINUTES=60
